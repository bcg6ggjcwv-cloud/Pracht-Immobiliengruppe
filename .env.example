# Vorlage: kopieren nach .env.local und Werte aus Supabase eintragen (Anleitung: docs/EINRICHTUNG.md).
# .env.local wird NIE ins Git hochgeladen.

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Geheim! Nur auf dem Server, niemals weitergeben oder in den Browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Adresse, unter der das Portal läuft (lokal: http://localhost:3000)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
